# ---------------------------------------------------------------------------
# Tampa Bay Family Clinic website — .gitignore
# Only files needed for the site to build/run are committed.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build output
dist/
.astro/

# Local env / secrets — never commit real values
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Cloudflare / Wrangler
.wrangler/
.dev.vars.tmp

# Local reference, planning & one-off tooling (kept on this machine only).
# Remove this line if you want the planning docs versioned too.
_project/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
