---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost' | 'link' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  icon?: IconName;
  iconPosition?: 'left' | 'right';
  fullWidth?: boolean;
  loading?: boolean;
  disabled?: boolean;
  external?: boolean;
  class?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  icon,
  iconPosition = 'left',
  fullWidth = false,
  loading = false,
  disabled = false,
  external = false,
  class: className = '',
  id,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-all duration-300 ease-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'bg-gradient-to-r from-primary-700 to-primary-500 text-white shadow-glow hover:from-primary-800 hover:to-primary-600 hover:shadow-lift active:from-primary-900 active:to-primary-700',
  secondary:
    'border-2 border-primary-600 bg-transparent text-primary-700 hover:bg-primary-600 hover:text-white dark:border-primary-400 dark:text-primary-300 dark:hover:bg-primary-600 dark:hover:text-white',
  accent:
    'bg-gradient-to-r from-accent-500 to-accent-400 text-accent-ink shadow-glow-accent hover:from-accent-600 hover:to-accent-500 active:from-accent-700 active:to-accent-600',
  inverse: 'bg-white text-primary-800 shadow-glow-inverse hover:bg-primary-50 active:bg-primary-100',
  ghost: 'text-brand hover:bg-primary-50 dark:hover:bg-primary-950/50',
  link: 'text-brand underline-offset-4 hover:underline !p-0 !min-h-0 !rounded-none',
};

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-4 py-2 text-sm min-h-[40px]',
  md: 'px-6 py-2.5 text-sm min-h-[44px]',
  lg: 'px-8 py-3.5 text-base min-h-[52px]',
};

const classes = [base, variants[variant], sizes[size], fullWidth ? 'w-full' : '', className]
  .filter(Boolean)
  .join(' ');
---

{href ? (
  <a
    href={href}
    id={id}
    class={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    aria-label={ariaLabel}
    {...rest}
  >
    {loading && (
      <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25" />
        <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      </svg>
    )}
    {icon && iconPosition === 'left' && !loading && <Icon name={icon} size={18} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={18} />}
  </a>
) : (
  <button
    type={type}
    id={id}
    class={classes}
    disabled={disabled || loading}
    aria-label={ariaLabel}
    {...rest}
  >
    {loading && (
      <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25" />
        <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
      </svg>
    )}
    {icon && iconPosition === 'left' && !loading && <Icon name={icon} size={18} />}
    <slot />
    {icon && iconPosition === 'right' && <Icon name={icon} size={18} />}
  </button>
)}
