---
import { icons, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', title, strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={icons[name]} />
</svg>
