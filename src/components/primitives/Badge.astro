---
interface Props {
  variant?: 'primary' | 'accent' | 'neutral' | 'success';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const variants = {
  primary:
    'bg-primary-50 text-primary-800 dark:bg-primary-950 dark:text-primary-200',
  accent: 'bg-accent-100 text-accent-800 dark:bg-accent-950 dark:text-accent-300',
  neutral: 'bg-ink-100 text-ink-700 dark:bg-ink-800 dark:text-ink-200',
  success: 'bg-success-subtle text-success',
};

const sizes = {
  sm: 'px-2.5 py-0.5 text-xs',
  md: 'px-3 py-1 text-xs',
};
---

<span
  class={`inline-flex items-center gap-1 rounded-full font-bold uppercase tracking-wide ${variants[variant]} ${sizes[size]} ${className}`}
>
  <slot />
</span>
