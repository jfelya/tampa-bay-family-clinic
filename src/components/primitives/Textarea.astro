---
interface Props {
  id: string;
  name: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  maxlength?: number;
  class?: string;
}

const {
  id,
  name,
  placeholder,
  rows = 5,
  required = false,
  maxlength,
  class: className = '',
} = Astro.props;
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required}
  maxlength={maxlength}
  aria-invalid="false"
  aria-describedby={`${id}-error`}
  class={`w-full resize-y rounded-lg border border-transparent bg-bg-subtle px-4 py-3 text-text transition-all duration-300 ease-soft placeholder:text-text-muted/70 focus:border-primary-400 focus:bg-surface focus:outline-none focus:ring-2 focus:ring-brand/25 aria-[invalid=true]:border-error aria-[invalid=true]:bg-error-subtle/40 ${className}`}
></textarea>
