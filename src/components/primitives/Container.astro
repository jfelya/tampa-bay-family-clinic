---
interface Props {
  size?: 'default' | 'narrow' | 'wide';
  as?: string;
  class?: string;
}

const { size = 'default', as: Tag = 'div', class: className = '' } = Astro.props;

const sizes = {
  default: 'max-w-content',
  narrow: 'max-w-3xl',
  wide: 'max-w-[1400px]',
};
---

<Tag class={`mx-auto w-full px-[var(--gutter)] ${sizes[size]} ${className}`}>
  <slot />
</Tag>
