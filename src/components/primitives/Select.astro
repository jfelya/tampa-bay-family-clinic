---
interface Props {
  id: string;
  name: string;
  options: readonly string[] | { value: string; label: string }[];
  placeholder?: string;
  required?: boolean;
  class?: string;
}

const { id, name, options, placeholder, required = false, class: className = '' } = Astro.props;

const normalized = options.map((option) =>
  typeof option === 'string' ? { value: option, label: option } : option
);
---

<select
  id={id}
  name={name}
  required={required}
  aria-invalid="false"
  aria-describedby={`${id}-error`}
  class={`w-full appearance-none rounded-lg border border-transparent bg-bg-subtle px-4 py-3 pr-10 text-text transition-all duration-300 ease-soft focus:border-primary-400 focus:bg-surface focus:outline-none focus:ring-2 focus:ring-brand/25 aria-[invalid=true]:border-error aria-[invalid=true]:bg-error-subtle/40 ${className}`}
>
  {placeholder && <option value="">{placeholder}</option>}
  {normalized.map((option) => <option value={option.value}>{option.label}</option>)}
</select>
