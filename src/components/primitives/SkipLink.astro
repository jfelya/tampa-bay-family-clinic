---
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
  target?: string;
}

const { locale = 'en', target = '#main' } = Astro.props;
const t = ui[locale];
---

<a
  href={target}
  class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[100] focus:rounded-md focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
>
  {t.skipToContent}
</a>
