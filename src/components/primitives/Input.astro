---
interface Props {
  id: string;
  name: string;
  type?: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  inputmode?: 'text' | 'email' | 'tel' | 'numeric';
  min?: string;
  class?: string;
}

const {
  id,
  name,
  type = 'text',
  placeholder,
  autocomplete,
  required = false,
  inputmode,
  min,
  class: className = '',
} = Astro.props;
---

<input
  id={id}
  name={name}
  type={type}
  placeholder={placeholder}
  autocomplete={autocomplete}
  required={required}
  inputmode={inputmode}
  min={min}
  aria-invalid="false"
  aria-describedby={`${id}-error`}
  class={`w-full rounded-lg border border-transparent bg-bg-subtle px-4 py-3 text-text transition-all duration-300 ease-soft placeholder:text-text-muted/70 focus:border-primary-400 focus:bg-surface focus:outline-none focus:ring-2 focus:ring-brand/25 aria-[invalid=true]:border-error aria-[invalid=true]:bg-error-subtle/40 ${className}`}
/>
