---
import Icon from './Icon.astro';

interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
  allowMultiple?: boolean;
  defaultOpen?: number;
  name?: string;
  class?: string;
}

const { items, allowMultiple = false, defaultOpen, name = 'accordion', class: className = '' } = Astro.props;
---

<div class={`divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface ${className}`}>
  {items.map((item, index) => (
    <details
      name={allowMultiple ? undefined : `${name}-group`}
      open={defaultOpen === index}
      class="group"
    >
      <summary
        class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-heading font-semibold text-text transition-colors duration-200 ease-soft hover:bg-bg-subtle focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus-ring [&::-webkit-details-marker]:hidden"
      >
        <span>{item.question}</span>
        <Icon
          name="chevron-down"
          size={20}
          class="shrink-0 text-text-muted transition-transform duration-200 ease-soft group-open:rotate-180"
        />
      </summary>
      <div class="px-5 pb-5 text-text-muted">
        <p class="whitespace-pre-line">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
