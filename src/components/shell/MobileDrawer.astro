---
import Icon from '../primitives/Icon.astro';
import IconButton from '../primitives/IconButton.astro';
import Button from '../primitives/Button.astro';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';
import { ui, type Locale } from '../../i18n/ui';
import logo from '../../assets/legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-logo-2-d15855e3b8.webp';

interface Props {
  locale: Locale;
  currentPath: string;
  alternateHref: string;
}

const { locale, currentPath, alternateHref } = Astro.props;
const t = ui[locale];
const info = site[locale];
const nav = navigation[locale];
const homeHref = locale === 'en' ? '/' : '/es/inicio/';

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const isActive = (href: string) => normalize(href) === normalize(currentPath);
---

<div
  id="mobileDrawer"
  class="fixed inset-0 z-50 hidden lg:hidden"
  data-drawer
  aria-hidden="true"
>
  <div class="absolute inset-0 bg-ink-950/60 backdrop-blur-[2px]" data-drawer-close></div>

  <div
    role="dialog"
    aria-modal="true"
    aria-label={t.menu}
    data-drawer-panel
    class="absolute right-0 top-0 flex h-full w-[88%] max-w-sm flex-col border-l border-border bg-surface shadow-lift"
  >
    <div class="flex h-16 shrink-0 items-center justify-between border-b border-border px-4">
      <a href={homeHref} class="inline-flex items-center">
        <span class="inline-flex rounded-md bg-white p-1 ring-1 ring-ink-900/10">
          <img src={logo.src} alt={info.name} width="150" height="81" class="h-9 w-auto" />
        </span>
      </a>
      <IconButton label={t.closeMenu} icon="x" variant="outlined" data-drawer-close />
    </div>

    <nav aria-label={t.mobileNavigation} class="flex-1 overflow-y-auto p-4">
      <ul class="space-y-1">
        {nav.primary.map((item) =>
          item.children ? (
            <li>
              <details class="group" name="drawer-services">
                <summary
                  class="flex min-h-[48px] cursor-pointer list-none items-center justify-between rounded-xl px-4 py-3 font-semibold text-text transition-colors duration-200 ease-soft hover:bg-bg-subtle focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus-ring [&::-webkit-details-marker]:hidden"
                >
                  <span>{item.label}</span>
                  <Icon
                    name="chevron-down"
                    size={18}
                    class="text-text-muted transition-transform duration-200 ease-soft group-open:rotate-180"
                  />
                </summary>
                <ul class="mt-1 space-y-1 border-l border-border pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isActive(child.href) ? 'page' : undefined}
                        class="block min-h-[44px] rounded-lg px-4 py-2.5 text-sm font-medium text-text-muted transition-colors duration-200 ease-soft hover:bg-bg-subtle hover:text-text aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-950 dark:aria-[current=page]:text-primary-200"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="flex min-h-[48px] items-center rounded-xl px-4 py-3 font-semibold text-text transition-colors duration-200 ease-soft hover:bg-bg-subtle aria-[current=page]:bg-primary-50 aria-[current=page]:text-primary-700 dark:aria-[current=page]:bg-primary-950 dark:aria-[current=page]:text-primary-200"
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="shrink-0 space-y-4 border-t border-border p-4">
      <div class="flex items-center justify-between">
        <LanguageToggle locale={locale} href={alternateHref} variant="light" />
        <ThemeToggle locale={locale} variant="light" />
      </div>
      <Button href={locale === 'en' ? '/contact-us/' : '/es/contactanos/'} fullWidth>
        {t.requestAppointment}
      </Button>
    </div>
  </div>
</div>
