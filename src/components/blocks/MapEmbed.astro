---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { site } from '../../data/site';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  heading?: string;
  body?: string;
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const { heading, body, tone = 'default', locale } = Astro.props;
const t = ui[locale];
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || body) && (
      <div class="mb-10" data-reveal>
        <SectionHeader heading={heading ?? t.mapTitle} intro={body} />
      </div>
    )}
    <div
      class="relative mt-2 aspect-[16/10] overflow-hidden rounded-xl border border-border/70 bg-bg-subtle shadow-card lg:aspect-[21/9]"
      data-map
      data-map-src={site[locale].mapEmbed}
      data-map-title={t.mapTitle}
      data-reveal
    >
      <p class="absolute inset-0 grid place-items-center text-sm text-text-muted" data-map-placeholder>
        {t.mapLoading}
      </p>
    </div>
  </Container>
</Section>

<script>
  import { initMaps } from '../../scripts/map';
  initMaps();
</script>
