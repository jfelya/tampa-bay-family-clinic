---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { requireAsset } from '../../lib/assets';

interface Item {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  href?: string;
}

interface Props {
  heading?: string;
  intro?: string;
  columns?: 2 | 3 | 4;
  items: Item[];
  tone?: 'default' | 'subtle';
}

const { heading, intro, columns = 3, items, tone = 'default' } = Astro.props;

const colClasses = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
};
---

<Section spacing={heading || intro ? 'md' : 'sm'} background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      heading ? (
        <SectionHeader heading={heading} intro={intro} class="mb-10" />
      ) : (
        <p class="mx-auto mb-10 max-w-2xl text-center text-text-muted">{intro}</p>
      )
    )}
    <ul class={`reveal-stagger grid gap-7 ${colClasses[columns]}`}>
      {items.map((item) => {
        const icon = item.image ? requireAsset(item.image) : undefined;
        const Tag = item.href ? 'a' : 'div';
        return (
          <li data-reveal>
            <Tag
              href={item.href}
              class:list={[
                'card-mecare flex h-full items-start gap-5 p-6',
                item.href && 'card-mecare-hover group',
              ]}
            >
              {icon && (
                <span class="icon-circle h-14 w-14">
                  <img
                    src={icon.src}
                    alt=""
                    width="32"
                    height="32"
                    class="h-8 w-8 object-contain"
                    loading="lazy"
                  />
                </span>
              )}
              <span>
                <span
                  class:list={[
                    'block font-heading text-lg font-bold text-text',
                    item.href && 'transition-colors duration-300 group-hover:text-primary-700 dark:group-hover:text-primary-300',
                  ]}
                >
                  {item.title}
                </span>
                <span class="mt-1.5 block text-sm leading-relaxed text-text-muted">{item.description}</span>
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </Container>
</Section>
