---
import { getCollection } from 'astro:content';
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { requireAsset } from '../../lib/assets';
import type { Locale } from '../../i18n/ui';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  icon?: string;
}

interface InlineItem {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  href: string;
}

interface Props {
  heading?: string;
  intro?: string;
  keys?: string[];
  items?: InlineItem[];
  limit?: number;
  action?: Action;
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const {
  heading,
  intro,
  keys,
  items,
  limit,
  action,
  tone = 'default',
  locale,
} = Astro.props;

interface Card {
  title: string;
  description: string;
  image?: string;
  href: string;
}

let cards: Card[] = [];

if (items?.length) {
  cards = items.map((item) => ({
    title: item.title,
    description: item.description,
    image: item.image,
    href: item.href,
  }));
} else {
  const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  let services = all;
  if (keys?.length) {
    services = keys
      .map((key) => all.find((service) => service.data.key === key))
      .filter((service): service is NonNullable<typeof service> => Boolean(service));
  }
  cards = services.map((service) => ({
    title: service.data.title[locale],
    description: service.data.description[locale],
    image: service.data.image,
    href: service.data.href[locale],
  }));
}

if (limit) cards = cards.slice(0, limit);

const columns = 'lg:grid-cols-3';
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      heading ? (
        <SectionHeader heading={heading} intro={intro} class="mb-12" />
      ) : (
        <p class="mx-auto mb-12 max-w-2xl text-center text-text-muted">{intro}</p>
      )
    )}
    <ul class={`reveal-stagger grid gap-7 sm:grid-cols-2 ${columns}`}>
      {cards.map((card) => {
        const icon = card.image ? requireAsset(card.image) : undefined;
        return (
          <li data-reveal>
            <a href={card.href} class="card-mecare card-mecare-hover group flex h-full flex-col p-7">
              {icon && (
                <span class="icon-circle mb-6 h-20 w-20">
                  <img
                    src={icon.src}
                    alt=""
                    width="44"
                    height="44"
                    class="h-11 w-11 object-contain"
                    loading="lazy"
                  />
                </span>
              )}
              <h3 class="font-heading text-lg font-bold text-text [overflow-wrap:anywhere] transition-colors duration-300 group-hover:text-primary-700 dark:group-hover:text-primary-300">
                {card.title}
              </h3>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-text-muted">{card.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">
                <Icon
                  name="arrow-right"
                  size={16}
                  class="transition-transform duration-300 ease-soft group-hover:translate-x-1.5"
                />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    {action && (
      <div class="mt-12 text-center" data-reveal>
        <Button href={action.href} variant={action.variant ?? 'ghost'} icon={action.icon as never}>
          {action.label}
        </Button>
      </div>
    )}
  </Container>
</Section>
