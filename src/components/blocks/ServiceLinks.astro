---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Icon from '../primitives/Icon.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import type { IconName } from '../../lib/icons';

interface Item {
  label: string;
  href: string;
  icon?: IconName;
  description?: string;
}

interface Props {
  heading?: string;
  intro?: string;
  items: Item[];
  tone?: 'default' | 'subtle';
}

const { heading, intro, items, tone = 'subtle' } = Astro.props;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      <div class="mb-10">
        {heading ? (
          <SectionHeader heading={heading} intro={intro} />
        ) : (
          <p class="mx-auto max-w-2xl text-center text-text-muted">{intro}</p>
        )}
      </div>
    )}
    <ul class="reveal-stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <li data-reveal>
          <a href={item.href} class="card-mecare card-mecare-hover group flex h-full items-center gap-4 p-5">
            <span class="icon-circle h-12 w-12 transition-colors duration-300 group-hover:bg-primary-600 group-hover:text-white">
              <Icon name={item.icon ?? 'arrow-right'} size={22} />
            </span>
            <span class="font-heading text-base font-bold text-text transition-colors duration-300 group-hover:text-primary-700 dark:group-hover:text-primary-300">
              {item.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Section>
