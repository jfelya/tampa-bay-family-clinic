---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Icon from '../primitives/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Item {
  label: string;
  href: string;
  icon?: IconName;
  description?: string;
}

interface Props {
  heading?: string;
  intro?: string;
  items: Item[];
  tone?: 'default' | 'subtle';
}

const { heading, intro, items, tone = 'subtle' } = Astro.props;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      <div class="mx-auto mb-10 max-w-2xl text-center">
        {heading && <h2>{heading}</h2>}
        {intro && <p class="mt-3 text-text-muted">{intro}</p>}
      </div>
    )}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="group flex h-full items-center gap-4 rounded-xl border border-border bg-surface p-5 shadow-soft transition-all duration-200 ease-soft hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-lift dark:hover:border-primary-800"
          >
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary-50 text-brand dark:bg-primary-950">
              <Icon name={item.icon ?? 'arrow-right'} size={22} />
            </span>
            <span class="font-heading text-base font-bold text-text group-hover:text-brand">
              {item.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Section>
