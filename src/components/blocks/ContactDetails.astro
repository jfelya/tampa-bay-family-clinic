---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { requireAsset } from '../../lib/assets';
import { site } from '../../data/site';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  heading?: string;
  tone?: 'default' | 'subtle';
  locale: Locale;
  showPhone?: boolean;
}

const { heading, tone = 'default', locale, showPhone = true } = Astro.props;
const t = ui[locale];
const info = site[locale];

const allCards = [
  {
    label: t.contactPhone,
    value: info.phone,
    href: info.phoneHref,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-phone-2-536c6e32c5.webp',
  },
  {
    label: t.contactHours,
    value: info.hours,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-hours-2-b9922d430f.webp',
  },
  {
    label: t.contactAddress,
    value: info.address,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-Address-fc1908dbc3.webp',
  },
  {
    label: t.contactEmail,
    value: info.email,
    href: `mailto:${info.email}`,
    icon: 'legacy/wp-content-uploads-2022-03-medical-handbook-Tampa-Family-clinics-206430828b.webp',
  },
];

const cards = showPhone ? allCards : allCards.filter((card) => card.label !== t.contactPhone);
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {heading && (
      <SectionHeader
        heading={heading}
        align="center"
        class="mb-12 [&_h2]:whitespace-pre-line"
      />
    )}
    <ul
      class={`reveal-stagger grid gap-7 sm:grid-cols-2 ${cards.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}
    >
      {cards.map((card) => (
        <li data-reveal class="min-w-0">
          <div class="card-mecare card-mecare-hover flex h-full flex-col items-center p-7 text-center">
            <span class="icon-circle h-16 w-16">
              <img
                src={requireAsset(card.icon).src}
                alt=""
                width="40"
                height="40"
                class="h-10 w-10 object-contain"
                loading="lazy"
              />
            </span>
            <h3 class="mt-5 font-heading text-base font-bold text-text">{card.label}</h3>
            {card.href ? (
              <a
                href={card.href}
                class="mt-1.5 block text-sm text-text-muted [overflow-wrap:anywhere] transition-colors duration-300 ease-soft hover:text-brand"
              >
                {card.value}
              </a>
            ) : (
              <p class="mt-1.5 text-sm text-text-muted [overflow-wrap:anywhere]">{card.value}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Container>
</Section>
