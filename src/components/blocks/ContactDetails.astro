---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import { requireAsset } from '../../lib/assets';
import { site } from '../../data/site';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  heading?: string;
  tone?: 'default' | 'subtle';
  locale: Locale;
  showPhone?: boolean;
}

const { heading, tone = 'default', locale, showPhone = true } = Astro.props;
const t = ui[locale];
const info = site[locale];

const allCards = [
  {
    label: t.contactPhone,
    value: info.phone,
    href: info.phoneHref,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-phone-2-536c6e32c5.webp',
  },
  {
    label: t.contactHours,
    value: info.hours,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-hours-2-b9922d430f.webp',
  },
  {
    label: t.contactAddress,
    value: info.address,
    icon: 'legacy/wp-content-uploads-2022-03-Tampa-Bay-Family-Clinic-Address-fc1908dbc3.webp',
  },
  {
    label: t.contactEmail,
    value: info.email,
    href: `mailto:${info.email}`,
    icon: 'legacy/wp-content-uploads-2022-03-medical-handbook-Tampa-Family-clinics-206430828b.webp',
  },
];

const cards = showPhone ? allCards : allCards.filter((card) => card.label !== t.contactPhone);
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {heading && <h2 class="mb-10 whitespace-pre-line text-center">{heading}</h2>}
    <ul class={`grid gap-6 sm:grid-cols-2 ${cards.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
      {cards.map((card) => (
        <li class="min-w-0 rounded-lg border border-border bg-surface p-6 text-center shadow-soft transition-all duration-200 ease-soft hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-lift dark:hover:border-primary-800">
          <img
            src={requireAsset(card.icon).src}
            alt=""
            width="48"
            height="48"
            class="mx-auto h-12 w-12 object-contain"
            loading="lazy"
          />
          <h3 class="mt-4 font-heading text-base font-bold text-text">{card.label}</h3>
          {card.href ? (
            <a
              href={card.href}
              class="mt-1 block text-sm text-text-muted [overflow-wrap:anywhere] transition-colors duration-200 ease-soft hover:text-brand"
            >
              {card.value}
            </a>
          ) : (
            <p class="mt-1 text-sm text-text-muted [overflow-wrap:anywhere]">{card.value}</p>
          )}
        </li>
      ))}
    </ul>
  </Container>
</Section>
