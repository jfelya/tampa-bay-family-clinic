---
import { Image } from 'astro:assets';
import Container from '../primitives/Container.astro';
import Icon from '../primitives/Icon.astro';
import Form from '../forms/Form.astro';
import { site } from '../../data/site';
import { requireAsset } from '../../lib/assets';
import type { Locale } from '../../i18n/ui';

interface Props {
  variant: 'appointment' | 'contact';
  heading?: string;
  body?: string;
  source: string;
  aside?: {
    heading?: string;
    callLabel?: string;
    emailLabel?: string;
  };
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const { variant, heading, body, source, aside, locale } = Astro.props;
const info = site[locale];

// Primary doctor as the section background (fades into the page background).
const doctorImage = requireAsset(
  'legacy/wp-content-uploads-2022-06-doctor-profile-tampa-famili-clinics-5-Mario-J.-Gonzalez-Fernandez-53b0fa2f47.webp'
);
---

<section
  id="appointment"
  class="relative scroll-mt-28 overflow-hidden border-y border-border bg-bg"
>
  <!-- Doctor background: visible on the left, fading into the background toward the right -->
  <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
    <Image
      src={doctorImage}
      alt=""
      widths={[1200, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover object-top"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-bg/70 to-bg"></div>
  </div>

  <Container class="relative py-12 lg:py-16">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16">
      <!-- Left column stays open so the doctor image reads -->
      <div class="hidden lg:block"></div>

      <div class="w-full lg:max-w-xl lg:justify-self-end">
        {heading && <h2>{heading}</h2>}
        {body && <p class="mt-4 text-text-muted">{body}</p>}

        {aside && (
          <div class="card-mecare mt-6 bg-surface/90 p-6 backdrop-blur-sm">
            {aside.heading && (
              <h3 class="font-heading text-base font-bold text-text">{aside.heading}</h3>
            )}
            <ul class="mt-3 space-y-3 text-sm">
              <li>
                <a href={info.phoneHref} class="group flex items-start gap-3">
                  <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-brand" />
                  <span>
                    <span class="block font-semibold text-text group-hover:text-brand">
                      {aside.callLabel}
                    </span>
                    <span class="block text-text-muted">{info.phone}</span>
                  </span>
                </a>
              </li>
              <li>
                <a href={`mailto:${info.email}`} class="group flex items-start gap-3">
                  <Icon name="mail" size={18} class="mt-0.5 shrink-0 text-brand" />
                  <span class="min-w-0">
                    <span class="block font-semibold text-text group-hover:text-brand">
                      {aside.emailLabel}
                    </span>
                    <span class="block break-all text-text-muted">{info.email}</span>
                  </span>
                </a>
              </li>
            </ul>
          </div>
        )}

        <div class="mt-6">
          <Form variant={variant} source={source} locale={locale} />
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import { initForms } from '../../scripts/form';
  initForms();
</script>
