---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Accordion from '../primitives/Accordion.astro';

interface Props {
  heading?: string;
  intro?: string;
  items: { question: string; answer: string }[];
  tone?: 'default' | 'subtle';
}

const { heading, intro, items, tone = 'default' } = Astro.props;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container size="narrow">
    {(heading || intro) && (
      <div class="mb-8 text-center">
        {heading && <h2>{heading}</h2>}
        {intro && <p class="mt-4 text-text-muted">{intro}</p>}
      </div>
    )}
    <Accordion items={items} />
  </Container>
</Section>
