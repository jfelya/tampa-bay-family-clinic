---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import { md } from '../../lib/markdown';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  icon?: string;
}

interface Props {
  heading: string;
  body?: string;
  actions?: Action[];
  tone?: 'primary' | 'accent' | 'subtle';
}

const { heading, body, actions = [], tone = 'primary' } = Astro.props;

const tones = {
  primary: 'bg-primary-950 text-white',
  accent: 'bg-accent-500 text-accent-ink',
  subtle: 'bg-bg-subtle text-text',
};

const defaultActionVariant = tone === 'accent' ? 'primary' : 'accent';
---

<section class={`${tones[tone]}`}>
  <Container class="flex flex-col items-center gap-6 py-14 text-center lg:py-20">
    <div class="max-w-2xl">
      <h2 class={tone === 'subtle' ? 'text-text' : 'text-white'}>{heading}</h2>
      {body && (
        <div
          class={`prose-tbfc mt-4 ${tone === 'primary' ? 'text-primary-100' : ''}`}
          set:html={md(body)}
        />
      )}
    </div>
    {actions.length > 0 && (
      <div class="flex flex-wrap justify-center gap-3">
        {actions.map((action) => (
          <Button
            href={action.href}
            variant={action.variant ?? defaultActionVariant}
            size="lg"
            icon={action.icon as never}
          >
            {action.label}
          </Button>
        ))}
      </div>
    )}
  </Container>
</section>
