---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { md } from '../../lib/markdown';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  icon?: string;
}

interface Props {
  heading: string;
  body?: string;
  actions?: Action[];
  tone?: 'primary' | 'accent' | 'subtle';
}

const { heading, body, actions = [], tone = 'primary' } = Astro.props;

const tones = {
  primary: 'bg-gradient-to-r from-primary-900 via-primary-700 to-primary-600 text-white',
  accent: 'bg-gradient-to-r from-accent-500 to-accent-400 text-accent-ink',
  subtle: 'bg-bg-subtle text-text',
};

const defaultActionVariant = tone === 'accent' ? 'primary' : 'accent';
const isDark = tone === 'primary';
---

<section class={`relative overflow-hidden ${tones[tone]}`}>
  {isDark && (
    <>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-white/5"
      ></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-28 -left-16 h-80 w-80 rounded-full bg-white/5"
      ></span>
    </>
  )}
  <Container class="relative flex flex-col items-center gap-7 py-16 text-center lg:py-24">
    <div class="max-w-2xl" data-reveal>
      <SectionHeader heading={heading} tone={isDark ? 'dark' : 'default'} />
      {body && (
        <div
          class={`prose-tbfc mt-5 ${isDark ? 'text-primary-100' : ''}`}
          set:html={md(body)}
        />
      )}
    </div>
    {actions.length > 0 && (
      <div class="flex flex-wrap justify-center gap-3" data-reveal>
        {actions.map((action) => (
          <Button
            href={action.href}
            variant={action.variant ?? defaultActionVariant}
            size="lg"
            icon={action.icon as never}
          >
            {action.label}
          </Button>
        ))}
      </div>
    )}
  </Container>
</section>
