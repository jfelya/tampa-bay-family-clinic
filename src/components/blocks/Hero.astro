---
import { Image } from 'astro:assets';
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import { requireAsset } from '../../lib/assets';
import type { IconName } from '../../lib/icons';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  icon?: string;
}

interface Feature {
  label: string;
  icon?: IconName;
}

interface Props {
  variant?: 'home' | 'page';
  eyebrow?: string;
  heading: string;
  subheading?: string;
  image?: string;
  imageAlt?: string;
  actions?: Action[];
  features?: Feature[];
}

const {
  variant = 'page',
  eyebrow,
  heading,
  subheading,
  image,
  imageAlt = '',
  actions = [],
  features = [],
} = Astro.props;

const isHome = variant === 'home';
const imageData = image ? requireAsset(image) : undefined;
const hasBackground = !isHome && Boolean(imageData);
---

{isHome ? (
  <section class="relative flex items-center overflow-hidden bg-primary-950 text-white lg:min-h-[calc(100vh-7rem)]">
    <!-- Photo on the right -->
    {imageData && (
      <div class="absolute inset-0 lg:left-auto lg:right-0 lg:w-[58%]">
        <Image
          src={imageData}
          alt={imageAlt}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-center"
        />
      </div>
    )}

    <!-- Mobile: keep text legible over the photo -->
    <div class="pointer-events-none absolute inset-0 bg-primary-950/80 lg:hidden" aria-hidden="true"></div>

    <!--
      Desktop fade: fully clear on the right; the blue builds smoothly toward
      the left — solid at the far left, easing out to transparent past ~60%.
    -->
    <div
      class="pointer-events-none absolute inset-0 hidden lg:block"
      style="background: linear-gradient(to right, #07273f 0%, #07273f 38%, rgba(7,39,63,0.98) 44%, rgba(7,39,63,0.93) 49%, rgba(7,39,63,0.86) 54%, rgba(7,39,63,0.76) 59%, rgba(7,39,63,0.64) 64%, rgba(7,39,63,0.5) 68%, rgba(7,39,63,0.36) 72%, rgba(7,39,63,0.23) 75%, rgba(7,39,63,0.12) 78%, rgba(7,39,63,0.04) 80%, rgba(7,39,63,0) 82%);"
      aria-hidden="true"
    ></div>

    <!-- Subtle diagonal accent over the photo -->

    <Container size="wide" class="relative w-full py-10 lg:py-12">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12">
        <div class="max-w-xl">
        {eyebrow && (
          <span class="inline-flex items-center rounded-full bg-accent-500 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-accent-950">
            {eyebrow}
          </span>
        )}

        <h1 class="hero-title mt-5 font-extrabold text-white">{heading}</h1>

        {subheading && (
          <p class="lead-text mt-5 max-w-xl whitespace-pre-line text-primary-100">{subheading}</p>
        )}

        {actions.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {actions.map((action) => (
              <Button
                href={action.href}
                variant="inverse"
                size="lg"
                icon={action.icon as never}
                iconPosition="right"
              >
                {action.label}
              </Button>
            ))}
          </div>
        )}

        {features.length > 0 && (
          <ul class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-4">
            {features.map((feature) => (
              <li class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/40 text-white">
                  <Icon name={feature.icon ?? 'check'} size={18} />
                </span>
                <span class="whitespace-pre-line text-xs font-medium leading-snug text-primary-100">
                  {feature.label}
                </span>
              </li>
            ))}
          </ul>
        )}
        </div>
      </div>
    </Container>
  </section>
) : (
  <section class="relative overflow-hidden border-b border-border bg-gradient-to-r from-primary-900 via-primary-700 to-primary-600">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-white/5"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-28 -left-16 h-80 w-80 rounded-full bg-white/5"
    ></span>

    {hasBackground && (
      <div class="absolute inset-0" aria-hidden="true">
        <Image
          src={imageData!}
          alt=""
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary-950/90 via-primary-900/75 to-primary-800/40"></div>
      </div>
    )}

    <Container class="relative py-14 lg:py-20">
      <div class="max-w-3xl" data-reveal>
        {eyebrow && <span class="section-eyebrow !text-white">{eyebrow}</span>}
        <h1 class="page-title mt-4 font-extrabold text-white">{heading}</h1>
        {subheading && (
          <p class="lead-text mt-5 max-w-2xl whitespace-pre-line text-primary-100">{subheading}</p>
        )}
        {actions.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {actions.map((action) => (
              <Button
                href={action.href}
                variant={action.variant === undefined || action.variant === 'primary' ? 'accent' : action.variant}
                size="lg"
                icon={action.icon as never}
                class="max-sm:w-full"
              >
                {action.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </Container>
  </section>
)}
