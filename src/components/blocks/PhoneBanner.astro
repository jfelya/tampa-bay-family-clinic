---
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Icon from '../primitives/Icon.astro';
import { site } from '../../data/site';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  label?: string;
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const { label, tone = 'subtle', locale } = Astro.props;
const t = ui[locale];
const info = site[locale];
---

<Section spacing="sm" background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    <div
      class="card-mecare flex flex-col items-center justify-between gap-6 p-7 sm:flex-row sm:p-9"
      data-reveal
    >
      <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
        <span class="icon-circle h-16 w-16">
          <Icon name="phone" size={26} />
        </span>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-text-muted">
            {label ?? t.phoneLabel}
          </p>
          <a
            href={info.phoneHref}
            class="font-heading text-2xl font-extrabold text-brand transition-colors duration-300 ease-soft hover:text-brand-hover lg:text-3xl"
          >
            {info.phone}
          </a>
        </div>
      </div>
      <button
        type="button"
        data-copy-phone={info.phone}
        data-copied-label={t.copiedPhone}
        class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border-2 border-primary-600 px-5 py-2.5 text-sm font-semibold text-primary-700 transition-all duration-300 ease-soft hover:bg-primary-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring dark:border-primary-400 dark:text-primary-300 dark:hover:bg-primary-600 dark:hover:text-white"
      >
        <Icon name="copy" size={16} />
        <span data-copy-label>{t.copyPhone}</span>
      </button>
    </div>
  </Container>
</Section>

<script>
  import { initCopy } from '../../scripts/copy';
  initCopy();
</script>
