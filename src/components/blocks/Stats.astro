---
import { Image } from 'astro:assets';
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { requireAsset } from '../../lib/assets';

interface Item {
  value: string;
  label: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  heading?: string;
  items: Item[];
  tone?: 'default' | 'subtle';
}

const { heading, items, tone = 'default' } = Astro.props;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {heading && <SectionHeader heading={heading} class="mb-12" />}
    <ul class="reveal-stagger grid grid-cols-2 gap-8 lg:grid-cols-4">
      {items.map((item) => (
        <li class="text-center" data-reveal>
          {item.image && (
            <Image
              src={requireAsset(item.image)}
              alt={item.imageAlt ?? ''}
              widths={[200, 313]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              loading="lazy"
              class="mx-auto h-28 w-28 object-contain lg:h-32 lg:w-32"
            />
          )}
          <p class="mt-4 font-heading text-4xl font-extrabold leading-none text-primary-600 dark:text-primary-300 lg:text-5xl">
            {item.value}
          </p>
          <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-text-muted">
            {item.label}
          </p>
        </li>
      ))}
    </ul>
  </Container>
</Section>
