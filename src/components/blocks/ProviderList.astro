---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import { requireAsset } from '../../lib/assets';
import type { Locale } from '../../i18n/ui';

interface Props {
  heading?: string;
  intro?: string;
  introImage?: string;
  introImageAlt?: string;
  keys?: string[];
  limit?: number;
  clamp?: boolean;
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const {
  heading,
  intro,
  introImage,
  introImageAlt = '',
  keys,
  limit,
  clamp = false,
  tone = 'default',
  locale,
} = Astro.props;

const all = (await getCollection('providers')).sort((a, b) => a.data.order - b.data.order);
let providers = all;
if (keys?.length) {
  providers = keys
    .map((key) => all.find((provider) => provider.id === key))
    .filter((provider): provider is NonNullable<typeof provider> => Boolean(provider));
}
if (limit) providers = providers.slice(0, limit);

const columns = providers.length >= 4 ? 'lg:grid-cols-4' : providers.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-2';
const introImageData = introImage ? requireAsset(introImage) : undefined;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      <div class="mx-auto mb-12 max-w-3xl text-center">
        {heading && <h2>{heading}</h2>}
        {intro && <p class="mt-4 whitespace-pre-line text-text-muted">{intro}</p>}
        {introImageData && (
          <Image
            src={introImageData}
            alt={introImageAlt}
            widths={[118, 236]}
            loading="lazy"
            class="mx-auto mt-4 h-10 w-auto opacity-90"
          />
        )}
      </div>
    )}
    <ul class={`grid gap-6 sm:grid-cols-2 ${columns}`}>
      {providers.map((provider) => {
        const data = provider.data;
        return (
          <li>
            <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-6 text-center shadow-soft transition-all duration-200 ease-soft hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-lift dark:hover:border-primary-800">
              <a href={data.href[locale]} class="group mx-auto inline-flex flex-col items-center">
                <Image
                  src={requireAsset(data.photo)}
                  alt={data.photoAlt}
                  widths={[320, 520, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 60vw"
                  loading="lazy"
                  class="h-40 w-40 rounded-full object-cover ring-4 ring-primary-100 transition-transform duration-200 ease-soft group-hover:scale-[1.03] sm:h-48 sm:w-48 dark:ring-primary-950"
                />
                <h3 class="mt-4 font-heading text-lg font-bold text-text group-hover:text-brand">
                  {data.name}
                </h3>
              </a>
              <p class="mt-1 text-sm font-medium text-brand">{data.specialty[locale]}</p>
              {data.bio && (
                <p class={`mt-3 whitespace-pre-line text-sm text-text-muted ${clamp ? 'line-clamp-4' : ''}`}>
                  {data.bio[locale]}
                </p>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  </Container>
</Section>
