---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { requireAsset } from '../../lib/assets';
import type { Locale } from '../../i18n/ui';

interface Props {
  heading?: string;
  intro?: string;
  introImage?: string;
  introImageAlt?: string;
  keys?: string[];
  limit?: number;
  clamp?: boolean;
  tone?: 'default' | 'subtle';
  locale: Locale;
}

const {
  heading,
  intro,
  introImage,
  introImageAlt = '',
  keys,
  limit,
  clamp = false,
  tone = 'default',
  locale,
} = Astro.props;

const all = (await getCollection('providers')).sort((a, b) => a.data.order - b.data.order);
let providers = all;
if (keys?.length) {
  providers = keys
    .map((key) => all.find((provider) => provider.id === key))
    .filter((provider): provider is NonNullable<typeof provider> => Boolean(provider));
}
if (limit) providers = providers.slice(0, limit);

const columns =
  providers.length >= 4
    ? 'lg:grid-cols-4'
    : providers.length === 3
      ? 'lg:grid-cols-3'
      : 'lg:grid-cols-2';
const introImageData = introImage ? requireAsset(introImage) : undefined;
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {(heading || intro) && (
      <div class="mx-auto mb-12 max-w-3xl text-center" data-reveal>
        {heading && <SectionHeader heading={heading} />}
        {intro && <p class="mt-5 whitespace-pre-line text-text-muted">{intro}</p>}
        {introImageData && (
          <Image
            src={introImageData}
            alt={introImageAlt}
            widths={[118, 236]}
            loading="lazy"
            class="mx-auto mt-5 h-10 w-auto opacity-90"
          />
        )}
      </div>
    )}
    <ul class={`reveal-stagger grid gap-7 sm:grid-cols-2 ${columns}`}>
      {providers.map((provider) => {
        const data = provider.data;
        return (
          <li data-reveal>
            <article class="card-mecare card-mecare-hover flex h-full flex-col p-7 text-center">
              <a href={data.href[locale]} class="group mx-auto inline-flex flex-col items-center">
                <Image
                  src={requireAsset(data.photo)}
                  alt={data.photoAlt}
                  widths={[320, 520, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 60vw"
                  loading="lazy"
                  class="h-40 w-40 rounded-full object-cover shadow-card ring-4 ring-primary-50 transition-transform duration-300 ease-soft group-hover:scale-[1.04] sm:h-44 sm:w-44 dark:ring-primary-950"
                />
                <h3 class="mt-5 font-heading text-lg font-bold text-text transition-colors duration-300 group-hover:text-primary-700 dark:group-hover:text-primary-300">
                  {data.name}
                </h3>
              </a>
              <p class="mt-1.5 text-sm font-semibold uppercase tracking-wide text-brand">
                {data.specialty[locale]}
              </p>
              {data.bio && (
                <p class={`mt-4 whitespace-pre-line text-sm leading-relaxed text-text-muted ${clamp ? 'line-clamp-4' : ''}`}>
                  {data.bio[locale]}
                </p>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  </Container>
</Section>
