---
interface Props {
  heading?: string;
  items: { label: string; href: string }[];
  tone?: 'default' | 'subtle';
}

const { heading, items } = Astro.props;
---

<nav
  aria-label={heading ?? 'On this page'}
  class="border-b border-border bg-bg-subtle/95 backdrop-blur"
>
  <div class="mx-auto flex max-w-content flex-wrap gap-2 px-4 py-3 sm:px-6 lg:px-8">
    {items.map((item) => (
      <a
        href={item.href}
        class="inline-flex min-h-[36px] items-center rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-medium text-text transition-colors duration-200 ease-soft hover:border-primary-200 hover:text-brand dark:hover:border-primary-800"
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>
