---
import { getCollection } from 'astro:content';
import Section from '../primitives/Section.astro';
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import { requireAsset } from '../../lib/assets';

interface Action {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'ghost';
  icon?: string;
}

interface Props {
  heading?: string;
  note?: string;
  action?: Action;
  tone?: 'default' | 'subtle';
}

const { heading, note, action, tone = 'default' } = Astro.props;
const insurances = (await getCollection('insurances')).sort((a, b) => a.data.order - b.data.order);
---

<Section background={tone === 'subtle' ? 'subtle' : 'default'} container="none">
  <Container>
    {heading && <h2 class="text-center">{heading}</h2>}
    <ul class="mt-10 grid grid-cols-2 items-stretch gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-6">
      {insurances.map((insurance) => (
        <li>
          <div
            class="flex h-full min-h-[104px] items-center justify-center rounded-lg border border-border bg-surface p-5 shadow-soft transition-all duration-200 ease-soft hover:scale-[1.04] hover:border-primary-200 hover:shadow-lift dark:hover:border-primary-800"
          >
            <img
              src={requireAsset(insurance.data.logo).src}
              alt={insurance.data.name}
              width="200"
              height="80"
              class="max-h-14 w-auto max-w-full object-contain"
              loading="lazy"
            />
          </div>
        </li>
      ))}
    </ul>
    {note && <p class="mt-6 text-center text-sm text-text-muted">{note}</p>}
    {action && (
      <div class="mt-8 text-center">
        <Button href={action.href} variant={action.variant ?? 'ghost'} icon={action.icon as never}>
          {action.label}
        </Button>
      </div>
    )}
  </Container>
</Section>
