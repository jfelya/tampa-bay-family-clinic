# ---------------------------------------------------------------------------
# Local development environment (PUBLIC values only — safe to keep in the repo).
# Copy to `.env` for `npm run dev` / `npm run build`.
# Real secrets belong in `.dev.vars` (git-ignored) and Cloudflare Pages env vars.
# ---------------------------------------------------------------------------

# Form behavior: `placeholder` = validate + show a "works, not sending yet" message.
# `live` = POST to /api/contact (requires Mailgun + Turnstile secrets).
PUBLIC_FORMS_MODE=placeholder

# Cloudflare Turnstile — public site key (safe to expose; known value).
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABiARh9BFmMA1WM_

# Cloudflare Web Analytics beacon token (PENDING — leave empty to omit the beacon).
PUBLIC_CF_BEACON_TOKEN=
